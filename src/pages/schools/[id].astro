---
import '../../styles/global.css';
import Header from '../../components/Header.astro';

const { id } = Astro.params;
const response = await fetch(new URL(`/api/schools/${id}`, Astro.url));

if (response.status === 404) {
  return Astro.redirect('/404');
}

const school = await response.json();
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{school.name} - Szczegóły</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
  </head>
  <body>
    <Header />
    
    <main class="container">
      <h2 style="text-align: center; margin-bottom: 0.5rem; color: var(--primary);">{school.name}</h2>
      <p style="text-align: center; color: #64748b; text-transform: uppercase; letter-spacing: 2px; font-size: 0.9rem; margin-bottom: 2rem;">
        {school.type}
      </p>
      
      <div class="card" style="max-width: 700px; margin: 0 auto; font-size: 1.1rem;">
        <p style="margin-bottom: 0.5rem;"><strong>📍 Adres:</strong> {school.address || "Brak danych"}</p>
        <p style="margin-bottom: 0.5rem;"><strong>👨‍🎓 Liczba uczniów:</strong> {school.students_count || "Brak danych"}</p>
        <p style="margin-bottom: 1.5rem;"><strong>🔗 Strona WWW:</strong> 
          <a href={school.website} target="_blank" style="color: var(--primary); text-decoration: none;">
            {school.website}
          </a>
        </p>
        
        <div style="text-align: center; margin-top: 2rem; border-top: 1px solid #e2e8f0; padding-top: 2rem;">
          <a href="/schools" class="btn">Powrót do listy szkół</a>
        </div>
      </div>
    </main>
  </body>
</html>