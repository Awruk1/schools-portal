---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import SchoolCard from '../../components/SchoolCard.astro';
import Map from '../../components/Map.astro';
import { schools } from '../../data/schools.js';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <title>Lista Szkół - Powiat Garwoliński</title>
    <style>
      .filters {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
      }
      .filter-btn {
        padding: 0.5rem 1.2rem;
        border: 2px solid var(--primary);
        border-radius: 8px;
        background: transparent;
        color: var(--primary);
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
      }
      .filter-btn.active {
        background-color: var(--primary);
        color: white;
      }
    </style>
  </head>
  <body>
    <Header />
    
    <main class="container">
      <h1 style="text-align: center; margin-bottom: 2rem;">Baza Szkół</h1>
      
      <div class="filters">
        <button class="filter-btn active" data-filter="all">Wszystkie</button>
        <button class="filter-btn" data-filter="liceum">Licea</button>
        <button class="filter-btn" data-filter="technikum">Technika</button>
        <button class="filter-btn" data-filter="branżowa">Szkoły Branżowe</button>
      </div>

      <Map schools={schools} />

      <div class="grid" id="schools-grid">
        {schools.map((school) => (
          <div class="school-item" data-type={school.type}>
            <SchoolCard 
              name={school.name} 
              type={school.type} 
              studentsCount={school.students_count} 
              id={school.id} 
            />
          </div>
        ))}
      </div>
    </main>

    <script is:inline>
      const buttons = document.querySelectorAll('.filter-btn');
      const items = document.querySelectorAll('.school-item');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const filter = btn.getAttribute('data-filter');

          items.forEach(item => {
            const types = item.getAttribute('data-type') || '';
            const matches = (filter === 'all') || 
                            (filter === 'branżowa' && (types.includes('branżowa') || types.includes('zawodowa'))) ||
                            types.includes(filter);

            item.style.display = matches ? 'block' : 'none';
          });

          if (typeof window.filterMapMarkers === 'function') {
            window.filterMapMarkers(filter);
          }
        });
      });
    </script>
  </body>
</html>