---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import SchoolCard from '../../components/SchoolCard.astro';
import Map from '../../components/Map.astro';

interface School {
  id: number;
  name: string;
  type: string;
  students_count: number;
  latitude: number;
  longitude: number;
}

const currentFilter = Astro.url.searchParams.get('type') || '';
const apiUrl = new URL('/api/schools', Astro.url);
if (currentFilter) apiUrl.searchParams.set('type', currentFilter);

const response = await fetch(apiUrl);
const schools: School[] = await response.json();
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Lista Szkół - Powiat Garwoliński</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <style>
      .filters {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
      }
      .filter-btn {
        padding: 0.5rem 1rem;
        border: 2px solid var(--primary);
        border-radius: 8px;
        text-decoration: none;
        color: var(--primary);
        font-weight: bold;
      }
      .filter-btn.active {
        background-color: var(--primary);
        color: white;
      }
    </style>
  </head>
  <body>
    <Header />
    
    <main class="container">
      <h1 style="text-align: center; margin-bottom: 2rem;">Baza Szkół</h1>
      
      <div class="filters">
        <a href="/schools" class={`filter-btn ${currentFilter === '' ? 'active' : ''}`}>Wszystkie</a>
        <a href="/schools?type=liceum" class={`filter-btn ${currentFilter === 'liceum' ? 'active' : ''}`}>Licea</a>
        <a href="/schools?type=technikum" class={`filter-btn ${currentFilter === 'technikum' ? 'active' : ''}`}>Technika</a>
        <a href="/schools?type=zawodowa" class={`filter-btn ${currentFilter === 'zawodowa' ? 'active' : ''}`}>Szkoły Branżowe</a>
      </div>

      <Map schools={schools} />

      <div class="grid">
        {schools.map((school) => (
          <SchoolCard 
            name={school.name} 
            type={school.type} 
            studentsCount={school.students_count} 
            id={school.id} 
          />
        ))}
      </div>
    </main>
  </body>
</html>