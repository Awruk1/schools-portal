---
import '../styles/global.css';
import Header from '../components/Header.astro';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <title>Panel Admina (D1 + JWT) - Szkoły Garwolin</title>
    <style>
      .login-wrapper {
        max-width: 450px;
        margin: 3.5rem auto;
      }
      .login-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.08);
      }
      .otp-input {
        letter-spacing: 0.45rem;
        font-size: 1.5rem !important;
        font-weight: 700;
        text-align: center;
        color: var(--primary);
      }
      .demo-token-box {
        background: #eff6ff;
        border: 1px dashed #3b82f6;
        border-radius: 8px;
        padding: 0.75rem;
        margin-bottom: 1rem;
        font-size: 0.85rem;
        color: #1e3a8a;
        text-align: center;
      }
      #admin-panel-content {
        display: none;
      }
      .admin-grid {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 2rem;
        align-items: start;
      }
      @media (max-width: 900px) {
        .admin-grid {
          grid-template-columns: 1fr;
        }
      }
      .form-group {
        margin-bottom: 1rem;
      }
      .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.35rem;
        font-size: 0.9rem;
      }
      .form-group input[type="text"],
      .form-group input[type="email"],
      .form-group input[type="number"],
      .form-group input[type="url"] {
        width: 100%;
        padding: 0.65rem 0.75rem;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 0.95rem;
        box-sizing: border-box;
      }
      .checkbox-group {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 0.25rem;
      }
      .checkbox-group label {
        font-weight: normal;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        cursor: pointer;
      }
      .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        background: #dcfce7;
        color: #166534;
      }
      .jwt-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        background: #dbeafe;
        color: #1e40af;
      }
      .admin-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
      }
      .admin-table th, .admin-table td {
        text-align: left;
        padding: 0.75rem;
        border-bottom: 1px solid #e2e8f0;
      }
      .admin-table th {
        background: #f8fafc;
        color: #475569;
        font-weight: 600;
      }
      .btn-danger {
        background: #ef4444;
        color: white;
        border: none;
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
      }
      .btn-danger:hover {
        background: #dc2626;
      }
      .btn-logout {
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #cbd5e1;
        padding: 0.4rem 0.85rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <Header />

    <main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
      
      <!-- EKRAN AUTORYZACJI TOKENEM E-MAIL (OTP + CLOUDFLARE JWT) -->
      <section id="login-screen" class="login-wrapper">
        <div class="login-card">
          <div style="text-align: center; margin-bottom: 1.5rem;">
            <div style="font-size: 2.5rem; margin-bottom: 0.4rem;">🔐</div>
            <h1 style="margin: 0 0 0.4rem 0; color: var(--primary); font-size: 1.45rem;">Autoryzacja Cloudflare OTP</h1>
            <p style="margin: 0; color: #64748b; font-size: 0.88rem;">
              Logowanie jednorazowym tokenem e-mail kodowanym przez Cloudflare WebCrypto (SHA-256 / JWT).
            </p>
          </div>

          <!-- KROK 1: Podanie adresu e-mail -->
          <form id="step1-email-form">
            <div class="form-group">
              <label for="admin-email">Adres e-mail administratora</label>
              <input type="email" id="admin-email" required placeholder="np. twoj.email@domena.pl" />
            </div>

            <button type="submit" id="send-otp-btn" class="btn" style="width: 100%; border: none; cursor: pointer; font-size: 1rem;">
              📨 Wyślij jednorazowy token na e-mail
            </button>
          </form>

          <!-- KROK 2: Wpisanie 6-cyfrowego tokenu OTP -->
          <form id="step2-otp-form" style="display: none;">
            <div id="otp-delivery-info" class="demo-token-box"></div>

            <div class="form-group">
              <label for="admin-otp">Wpisz 6-cyfrowy token jednorazowy (OTP)</label>
              <input 
                type="text" 
                id="admin-otp" 
                class="otp-input" 
                maxlength="6" 
                pattern="[0-9]{6}" 
                required 
                placeholder="000000" 
                autocomplete="one-time-code"
              />
            </div>

            <button type="submit" class="btn" style="width: 100%; border: none; cursor: pointer; font-size: 1rem;">
              🔓 Zweryfikuj token i odbierz klucz JWT
            </button>

            <button type="button" id="back-to-email-btn" style="width: 100%; background: none; border: none; color: #64748b; margin-top: 0.75rem; cursor: pointer; font-size: 0.85rem; text-decoration: underline;">
              ← Zmień adres e-mail lub wyślij nowy kod
            </button>
          </form>

          <p id="login-error" style="color: #dc2626; font-size: 0.88rem; text-align: center; margin-top: 0.85rem; display: none;"></p>
        </div>
      </section>

      <!-- ZABEZPIECZONA ZAWARTOŚĆ PANELU ADMINA -->
      <section id="admin-panel-content">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
          <div>
            <h1 style="margin: 0 0 0.5rem 0; color: var(--primary);">⚙️ Panel Administracyjny D1</h1>
            <p style="margin: 0; color: #64748b; font-size: 0.9rem;">
              Zalogowano jako: <strong id="logged-admin-email" style="color: #0f172a;">-</strong>
            </p>
          </div>
          <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
            <span id="jwt-method-badge" class="jwt-badge">🔐 JWT HS256</span>
            <span id="db-status" class="status-badge">⏳ Łączenie z D1...</span>
            <a href="/api/schools" target="_blank" class="btn" style="margin: 0; padding: 0.4rem 0.85rem; font-size: 0.85rem;">JSON API ↗</a>
            <button id="logout-btn" class="btn-logout">🚪 Wyloguj</button>
          </div>
        </div>

        <div class="admin-grid">
          <!-- Formularz dodawania szkoły -->
          <div class="card">
            <h2 style="margin-top: 0; margin-bottom: 1rem; font-size: 1.25rem;">➕ Dodaj nową szkołę</h2>
            <form id="add-school-form">
              <div class="form-group">
                <label>Nazwa szkoły *</label>
                <input type="text" name="name" required placeholder="np. Zespół Szkół nr 3 w Garwolinie" />
              </div>

              <div class="form-group">
                <label>Typ placówki *</label>
                <div class="checkbox-group">
                  <label><input type="checkbox" name="type_opt" value="liceum" checked /> 🎓 Liceum</label>
                  <label><input type="checkbox" name="type_opt" value="technikum" /> ⚙️ Technikum</label>
                  <label><input type="checkbox" name="type_opt" value="branżowa" /> 🔧 Branżowa</label>
                </div>
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                <div class="form-group">
                  <label>Szerokość (Lat) *</label>
                  <input type="number" step="any" name="latitude" required value="51.8955" />
                </div>
                <div class="form-group">
                  <label>Długość (Lng) *</label>
                  <input type="number" step="any" name="longitude" required value="21.6100" />
                </div>
              </div>

              <div class="form-group">
                <label>Adres *</label>
                <input type="text" name="address" required placeholder="ul. Przykładowa 1, 08-400 Garwolin" />
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                <div class="form-group">
                  <label>Liczba uczniów *</label>
                  <input type="number" name="students_count" required value="450" />
                </div>
                <div class="form-group">
                  <label>Telefon</label>
                  <input type="text" name="phone" placeholder="+48 25 682 00 00" />
                </div>
              </div>

              <div class="form-group">
                <label>Strona WWW</label>
                <input type="url" name="website" placeholder="https://example.edu.pl" />
              </div>

              <div class="form-group">
                <label>Specjalizacje (oddzielone przecinkiem)</label>
                <input type="text" name="specializations" placeholder="Technik informatyk, Profil matematyczny" />
              </div>

              <button type="submit" class="btn" style="width: 100%; border: none; cursor: pointer; font-size: 1rem; margin-top: 0.5rem;">
                Zapisz w bazie D1
              </button>
              <p id="form-msg" style="margin-top: 0.75rem; font-size: 0.9rem; text-align: center;"></p>
            </form>
          </div>

          <!-- Tabela szkół w bazie D1 -->
          <div class="card" style="overflow-x: auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <h2 style="margin: 0; font-size: 1.25rem;">📋 Rekordy w bazie D1 (<span id="schools-count">0</span>)</h2>
              <button id="refresh-btn" style="background: none; border: 1px solid #cbd5e1; padding: 0.35rem 0.75rem; border-radius: 6px; cursor: pointer;">🔄 Odśwież</button>
            </div>

            <table class="admin-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Nazwa</th>
                  <th>Typ</th>
                  <th>Uczniowie</th>
                  <th>Akcja</th>
                </tr>
              </thead>
              <tbody id="admin-schools-tbody">
                <tr>
                  <td colspan="5" style="text-align: center; padding: 2rem; color: #64748b;">Pobieranie danych z bazy D1...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </main>

    <script is:inline>
      const AUTH_STORAGE_KEY = 'schools_admin_jwt';

      const loginScreen = document.getElementById('login-screen');
      const adminPanelContent = document.getElementById('admin-panel-content');
      const step1Form = document.getElementById('step1-email-form');
      const step2Form = document.getElementById('step2-otp-form');
      const emailInput = document.getElementById('admin-email');
      const otpInput = document.getElementById('admin-otp');
      const otpDeliveryInfo = document.getElementById('otp-delivery-info');
      const backToEmailBtn = document.getElementById('back-to-email-btn');
      const loginError = document.getElementById('login-error');
      const logoutBtn = document.getElementById('logout-btn');

      const loggedEmailEl = document.getElementById('logged-admin-email');
      const jwtMethodBadge = document.getElementById('jwt-method-badge');
      const tbody = document.getElementById('admin-schools-tbody');
      const countEl = document.getElementById('schools-count');
      const statusEl = document.getElementById('db-status');
      const form = document.getElementById('add-school-form');
      const formMsg = document.getElementById('form-msg');
      const refreshBtn = document.getElementById('refresh-btn');

      let currentEmail = '';

      function getAuthToken() {
        return sessionStorage.getItem(AUTH_STORAGE_KEY) || '';
      }

      async function checkSessionAndUnlock() {
        try {
          const token = getAuthToken();
          const res = await fetch('/api/schools?auth_check=1', {
            headers: token ? { 'Authorization': 'Bearer ' + token } : {}
          });

          if (res.ok) {
            const data = await res.json();
            loginScreen.style.display = 'none';
            adminPanelContent.style.display = 'block';
            loggedEmailEl.textContent = data.email || 'Administrator';
            jwtMethodBadge.textContent = '🔐 ' + (data.method || 'Cloudflare JWT');
            await loadSchoolsFromD1();
            return true;
          }
        } catch (e) {}
        return false;
      }

      // KROK 1: Wysłanie żądania o wygenerowanie i zakodowanie tokenu OTP
      step1Form.addEventListener('submit', async (e) => {
        e.preventDefault();
        loginError.style.display = 'none';
        currentEmail = emailInput.value.trim();

        const sendBtn = document.getElementById('send-otp-btn');
        sendBtn.textContent = '⏳ Generowanie i szyfrowanie tokenu...';
        sendBtn.disabled = true;

        try {
          const res = await fetch('/api/schools?action=request_otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: currentEmail })
          });
          const data = await res.json();

          if (!res.ok) throw new Error(data.error || 'Błąd generowania tokenu');

          step1Form.style.display = 'none';
          step2Form.style.display = 'block';

          if (data.emailSent) {
            otpDeliveryInfo.innerHTML = `✅ Wysłano 6-cyfrowy token na adres <strong>${currentEmail}</strong>. Sprawdź skrzynkę odbiorczą.`;
          } else {
            otpDeliveryInfo.innerHTML = `
              📨 Token dla <strong>${currentEmail}</strong> został wygenerowany i zahashowany (SHA-256) w bazie Cloudflare D1.<br>
              <span style="display:inline-block; margin-top:0.35rem; font-size: 0.95rem;">
                Twój jednorazowy kod dostępu: <strong style="font-size:1.15rem; color:#2563eb; letter-spacing:2px;">${data.demoOtpPreview}</strong>
              </span>
            `;
          }
          otpInput.focus();
        } catch (err) {
          loginError.textContent = '❌ ' + err.message;
          loginError.style.display = 'block';
        } finally {
          sendBtn.textContent = '📨 Wyślij jednorazowy token na e-mail';
          sendBtn.disabled = false;
        }
      });

      // KROK 2: Weryfikacja 6-cyfrowego kodu i odebranie podpisanego tokenu JWT
      step2Form.addEventListener('submit', async (e) => {
        e.preventDefault();
        loginError.style.display = 'none';

        try {
          const res = await fetch('/api/schools?action=verify_otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: currentEmail,
              otp: otpInput.value.trim()
            })
          });
          const data = await res.json();

          if (!res.ok) throw new Error(data.error || 'Nieprawidłowy token');

          sessionStorage.setItem(AUTH_STORAGE_KEY, data.token);
          await checkSessionAndUnlock();
        } catch (err) {
          loginError.textContent = '❌ ' + err.message;
          loginError.style.display = 'block';
        }
      });

      backToEmailBtn.addEventListener('click', () => {
        step2Form.style.display = 'none';
        step1Form.style.display = 'block';
        otpInput.value = '';
        loginError.style.display = 'none';
      });

      logoutBtn.addEventListener('click', () => {
        sessionStorage.removeItem(AUTH_STORAGE_KEY);
        step1Form.reset();
        step2Form.reset();
        step2Form.style.display = 'none';
        step1Form.style.display = 'block';
        adminPanelContent.style.display = 'none';
        loginScreen.style.display = 'block';
      });

      async function loadSchoolsFromD1() {
        try {
          const res = await fetch('/api/schools');
          if (!res.ok) throw new Error('Błąd HTTP: ' + res.status);
          const data = await res.json();

          statusEl.textContent = '🟢 Połączono z D1';
          statusEl.style.background = '#dcfce7';
          statusEl.style.color = '#166534';
          countEl.textContent = data.length;

          if (data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding: 1.5rem;">Brak szkół w bazie D1.</td></tr>';
            return;
          }

          tbody.innerHTML = data.map(s => `
            <tr>
              <td><strong>#${s.id}</strong></td>
              <td>${s.name}<br><small style="color:#64748b;">${s.address || ''}</small></td>
              <td><span style="font-size: 0.8rem; background: #f1f5f9; padding: 0.2rem 0.5rem; border-radius: 4px;">${s.type}</span></td>
              <td>${s.students_count || 0}</td>
              <td>
                <button class="btn-danger" onclick="deleteSchool(${s.id})">Usuń</button>
              </td>
            </tr>
          `).join('');
        } catch (err) {
          statusEl.textContent = '🔴 Brak połączenia z D1';
          statusEl.style.background = '#fee2e2';
          statusEl.style.color = '#991b1b';
        }
      }

      window.deleteSchool = async function(id) {
        if (!confirm('Czy na pewno chcesz usunąć szkołę #' + id + ' z bazy D1?')) return;
        try {
          const res = await fetch('/api/schools?id=' + id, {
            method: 'DELETE',
            headers: { 'Authorization': 'Bearer ' + getAuthToken() }
          });
          if (res.ok) {
            await loadSchoolsFromD1();
          } else {
            alert('Błąd autoryzacji JWT lub usuwania rekordu.');
          }
        } catch (e) {
          alert('Błąd sieci: ' + e.message);
        }
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const checkedTypes = Array.from(form.querySelectorAll('input[name="type_opt"]:checked')).map(cb => cb.value);

        if (checkedTypes.length === 0) {
          formMsg.style.color = '#dc2626';
          formMsg.textContent = 'Zaznacz przynajmniej jeden typ placówki!';
          return;
        }

        const specsRaw = formData.get('specializations') || '';
        const specsArray = specsRaw.split(',').map(s => s.trim()).filter(Boolean);

        const payload = {
          name: formData.get('name'),
          type: checkedTypes.join(', '),
          latitude: parseFloat(formData.get('latitude')),
          longitude: parseFloat(formData.get('longitude')),
          address: formData.get('address'),
          students_count: parseInt(formData.get('students_count'), 10),
          phone: formData.get('phone'),
          website: formData.get('website'),
          specializations: specsArray
        };

        formMsg.style.color = '#2563eb';
        formMsg.textContent = 'Zapisywanie w bazie D1...';

        try {
          const res = await fetch('/api/schools', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': 'Bearer ' + getAuthToken()
            },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            formMsg.style.color = '#166534';
            formMsg.textContent = '✅ Szkoła została dodana do bazy D1!';
            form.reset();
            await loadSchoolsFromD1();
          } else {
            throw new Error('Brak ważnego tokenu JWT (' + res.status + ')');
          }
        } catch (err) {
          formMsg.style.color = '#dc2626';
          formMsg.textContent = '❌ Błąd zapisu: ' + err.message;
        }
      });

      refreshBtn.addEventListener('click', loadSchoolsFromD1);

      document.addEventListener('DOMContentLoaded', () => {
        checkSessionAndUnlock();
      });
    </script>
  </body>
</html>