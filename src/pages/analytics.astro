---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { schools } from '../data/schools.js';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="manifest" href="/manifest.json" />
    <title>Analytics & Statystyki - Szkoły Garwolin</title>
    <style>
      .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
      }
      .stat-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        box-shadow: 0 2px 4px rgb(0 0 0 / 0.03);
      }
      .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--primary);
        margin: 0.5rem 0;
      }
      .ranking-row {
        margin-bottom: 1.1rem;
      }
      .ranking-header {
        display: flex;
        justify-content: space-between;
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
        color: #1e293b;
      }
      .bar-bg {
        width: 100%;
        height: 12px;
        background: #f1f5f9;
        border-radius: 999px;
        overflow: hidden;
      }
      .bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #2563eb, #3b82f6);
        border-radius: 999px;
        transition: width 0.4s ease;
      }
    </style>
  </head>
  <body>
    <Header />

    <main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
        <div>
          <h1 style="margin: 0 0 0.4rem 0; color: var(--primary);">📊 Analytics & Popularność Szkół</h1>
          <p style="margin: 0; color: #64748b;">Statystyki wyświetleń mapy oraz najpopularniejszych placówek (Cloudflare D1 + Web Analytics).</p>
        </div>
        <button id="refresh-analytics" class="btn" style="margin: 0; border: none; cursor: pointer;">🔄 Odśwież dane</button>
      </div>

      <div class="stats-cards">
        <div class="stat-card">
          <div style="color: #64748b; font-weight: 600; font-size: 0.9rem;">🗺️ WIDOKI INTERAKTYWNEJ MAPY</div>
          <div class="stat-number" id="map-views-count">0</div>
          <div style="font-size: 0.82rem; color: #16a34a;">Zliczane przy każdym otwarciu mapy</div>
        </div>

        <div class="stat-card">
          <div style="color: #64748b; font-weight: 600; font-size: 0.9rem;">🏫 ODSŁONY PROFILI SZKÓŁ</div>
          <div class="stat-number" id="school-views-total">0</div>
          <div style="font-size: 0.82rem; color: #475569;">Łączna liczba wyświetleń kart szczegółów</div>
        </div>

        <div class="stat-card">
          <div style="color: #64748b; font-weight: 600; font-size: 0.9rem;">📱 STATUS PWA / OFFLINE</div>
          <div class="stat-number" id="pwa-status-text" style="font-size: 1.6rem; margin: 1rem 0;">Aktywny ✅</div>
          <div style="font-size: 0.82rem; color: #475569;">Service Worker + Manifest gotowe</div>
        </div>
      </div>

      <div class="card">
        <h2 style="margin-top: 0; margin-bottom: 1.5rem; font-size: 1.3rem; color: #0f172a;">
          🔥 Ranking najpopularniejszych szkół
        </h2>
        <div id="ranking-container">
          <p style="color: #64748b; text-align: center; padding: 2rem;">Ładowanie statystyk...</p>
        </div>
      </div>
    </main>

    <script is:inline define:vars={{ schools }}>
      const mapViewsEl = document.getElementById('map-views-count');
      const schoolViewsTotalEl = document.getElementById('school-views-total');
      const rankingContainer = document.getElementById('ranking-container');
      const refreshBtn = document.getElementById('refresh-analytics');

      async function loadAnalytics() {
        let metricsMap = {};

        // 1. Pobieramy statystyki z bazy Cloudflare D1 (/api/analytics)
        try {
          const res = await fetch('/api/analytics');
          if (res.ok) {
            const rows = await res.json();
            rows.forEach(r => {
              metricsMap[r.metric_key] = Number(r.views) || 0;
            });
          }
        } catch (e) {
          // Fallback do localStorage w trybie offline/lokalnym
          const localData = JSON.parse(localStorage.getItem('local_analytics') || '{}');
          metricsMap = localData;
        }

        const mapViews = metricsMap['map_views'] || 1;
        mapViewsEl.textContent = mapViews;

        // 2. Zestawiamy szkoły z ich liczbą wyświetleń
        const rankedSchools = schools.map(s => {
          const views = metricsMap[`school_${s.id}`] || 0;
          return { ...s, views };
        }).sort((a, b) => b.views - a.views);

        const totalSchoolViews = rankedSchools.reduce((sum, s) => sum + s.views, 0);
        schoolViewsTotalEl.textContent = totalSchoolViews;

        const maxViews = Math.max(...rankedSchools.map(s => s.views), 1);

        rankingContainer.innerHTML = rankedSchools.map((s, idx) => {
          const percent = Math.round((s.views / maxViews) * 100);
          return `
            <div class="ranking-row">
              <div class="ranking-header">
                <span><strong>#${idx + 1}</strong> <a href="/schools/${s.id}" style="color: inherit; text-decoration: none;">${s.name}</a></span>
                <span style="color: var(--primary); white-space: nowrap;">👁️ ${s.views} wyświetleń</span>
              </div>
              <div class="bar-bg">
                <div class="bar-fill" style="width: ${ s.views > 0 ? Math.max(percent, 6) : 0 }%;"></div>
              </div>
            </div>
          `;
        }).join('');
      }

      refreshBtn.addEventListener('click', loadAnalytics);
      document.addEventListener('DOMContentLoaded', loadAnalytics);
    </script>
  </body>
</html>